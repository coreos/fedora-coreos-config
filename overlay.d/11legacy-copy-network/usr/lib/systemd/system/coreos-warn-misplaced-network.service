[Unit]
Description=Warn if firstboot network config was placed in /boot by older coreos-installer
ConditionFirstBoot=true
ConditionPathExists=/run/coreos/legacy-network-rescued

[Service]
Type=oneshot
ExecStart=/usr/libexec/coreos-warn-misplaced-network
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
